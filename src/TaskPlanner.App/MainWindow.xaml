<Window x:Class="TaskPlanner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:app="clr-namespace:TaskPlanner.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Task Planner"
        Width="560"
        Height="720"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52"
                            CornerRadius="12"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource ChromeBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="52" Margin="16,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="28"
                            Height="28"
                            CornerRadius="7"
                            Background="{DynamicResource AccentBrush}"
                            Margin="0,0,10,0">
                        <TextBlock Text="✓"
                                   Foreground="#FFFFFF"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Task Planner"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Quick planning overlay"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="11" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="Start with Windows"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,8,10" />
                    <primitives:ToggleButton Style="{StaticResource SwitchToggleStyle}"
                                             IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,18,10"
                                             ToolTip="Start Task Planner automatically when you sign in to Windows" />
                    <TextBlock Text="Theme"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,8,10" />
                    <ComboBox Width="96"
                              ItemsSource="{Binding ThemeModes}"
                              SelectedItem="{Binding SelectedThemeMode, Mode=TwoWay}" />
                </StackPanel>
                <Button Grid.Column="2"
                        Content="×"
                        Style="{StaticResource ChromeButtonStyle}"
                        Command="{Binding ExitCommand}"
                        ToolTip="Exit Task Planner" />
            </Grid>

            <Border Grid.Row="1"
                    Margin="16,8,16,14"
                    Padding="16"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="Capture a task"
                               Style="{StaticResource SectionTitleStyle}" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="QuickAddBox"
                                 Grid.Column="0"
                                 Margin="0,0,10,0"
                                 Text="{Binding NewTaskText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Examples: Send report tomorrow !high" />
                        <Button Grid.Column="1"
                                Content="Add task"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding AddTaskCommand}" />
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="16,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Margin="0,0,10,0"
                        Padding="14"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Tasks"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <ComboBox DockPanel.Dock="Top"
                                  ItemsSource="{Binding ViewKinds}"
                                  SelectedItem="{Binding SelectedView, Mode=TwoWay}" />

                        <ListBox ItemsSource="{Binding Tasks}"
                                 SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                                 AllowDrop="True"
                                 PreviewMouseLeftButtonDown="TaskList_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="TaskList_PreviewMouseMove"
                                 Drop="TaskList_Drop">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="4"
                                                CornerRadius="2"
                                                Background="{DynamicResource AccentBrush}"
                                                Margin="0,2,10,2" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock app:LinkTextBlockBehavior.Segments="{Binding DisplayTitleSegments}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Summary}"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="12"
                                                       Margin="0,3,0,0" />
                                            <ItemsControl ItemsSource="{Binding NotePreviewLines}"
                                                          Margin="0,2,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   FontStyle="Italic"
                                                                   FontSize="11"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1"
                        Margin="10,0,0,0"
                        Padding="14"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="Details"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Title"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="12" />
                        <TextBox Text="{Binding EditTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Priority"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="12" />
                        <ComboBox ItemsSource="{Binding PriorityValues}"
                                  SelectedItem="{Binding EditPriority, Mode=TwoWay}" />
                        <TextBlock Text="Due date"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="12" />
                        <DatePicker SelectedDate="{Binding EditDueDate, Mode=TwoWay}" Margin="0,0,0,10" />
                        <CheckBox Content="Recurring"
                                  Foreground="{DynamicResource TextBrush}"
                                  IsChecked="{Binding EditIsRecurring, Mode=TwoWay}"
                                  Margin="0,0,0,10" />
                        <ComboBox ItemsSource="{Binding RecurrenceValues}"
                                  SelectedItem="{Binding EditRecurrenceFrequency, Mode=TwoWay}" />
                        <TextBlock Text="Notes"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="12"
                                   Margin="0,10,0,0" />
                        <ItemsControl ItemsSource="{Binding SelectedTaskNotes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 LostFocus="NoteTextBox_LostFocus" />
                                        <Button Grid.Column="1"
                                                Content="×"
                                                Margin="6,0,0,0"
                                                Command="{Binding DataContext.RemoveNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Delete note" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,6,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding NewNoteText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Add a note" />
                            <Button Grid.Column="1"
                                    Content="Add note"
                                    Margin="6,0,0,0"
                                    Command="{Binding AddNoteCommand}" />
                        </Grid>
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="Save"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Command="{Binding SaveSelectedCommand}" />
                            <Button Content="Done"
                                    Command="{Binding CompleteSelectedCommand}" />
                            <Button Content="Delete"
                                    Command="{Binding DeleteSelectedCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Grid.Row="3"
                       Text="Ctrl+Shift+Space toggles the panel. Escape hides it."
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="12"
                       Margin="18,12,18,16" />
        </Grid>
    </Border>
</Window>
