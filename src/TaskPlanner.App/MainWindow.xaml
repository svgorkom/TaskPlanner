<Window x:Class="TaskPlanner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:app="clr-namespace:TaskPlanner.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Task Planner"
        Width="600"
        Height="760"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <app:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <DataTemplate x:Key="TaskItemTemplate">
            <StackPanel>
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                    <Setter Property="Opacity" Value="0.55" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="4"
                            CornerRadius="2"
                            Background="{DynamicResource AccentBrush}"
                            Margin="0,2,10,2" />
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                        <TextBlock app:LinkTextBlockBehavior.Segments="{Binding DisplayTitleSegments}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" />
                        <ItemsControl ItemsSource="{Binding NotePreviewLines}"
                                      Margin="0,2,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontStyle="Italic"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="30" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="8,0,0,0">
                        <Button Content="{Binding ToggleGlyph}"
                                Width="26"
                                Height="26"
                                Padding="0"
                                ToolTip="Edit task"
                                Command="{Binding DataContext.ToggleTaskExpandedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                        <Button Content="✓"
                                Width="26"
                                Height="26"
                                Padding="0"
                                Margin="4,0,0,0"
                                Visibility="{Binding IsCompleted, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                ToolTip="Mark done"
                                Command="{Binding DataContext.CompleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                        <Button Content="↺"
                                Width="26"
                                Height="26"
                                Padding="0"
                                Margin="4,0,0,0"
                                Visibility="{Binding IsCompleted, Converter={StaticResource BooleanToVisibilityConverter}}"
                                ToolTip="Reopen task"
                                Command="{Binding DataContext.ReopenTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                        <Button Content="✕"
                                Width="26"
                                Height="26"
                                Padding="0"
                                Margin="4,0,0,0"
                                Style="{StaticResource DestructiveButtonStyle}"
                                ToolTip="Delete task"
                                Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
                <Border Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Margin="14,8,0,4"
                        Padding="10"
                        Background="{DynamicResource SubtleSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Title"
                                   Style="{StaticResource FormLabelStyle}" />
                        <TextBox Text="{Binding EditTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="False" />
                        <TextBlock Text="Topic"
                                   Style="{StaticResource FormLabelStyle}"
                                   Margin="0,8,0,4" />
                        <ComboBox ItemsSource="{Binding DataContext.Topics, RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectedItem="{Binding EditTopic, Mode=TwoWay}" />
                        <TextBlock Text="Notes"
                                   Style="{StaticResource FormLabelStyle}"
                                   Margin="0,4,0,0" />
                        <ItemsControl ItemsSource="{Binding Notes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 LostFocus="NoteTextBox_LostFocus" />
                                        <Button Grid.Column="1"
                                                Content="×"
                                                Margin="6,0,0,0"
                                                Command="{Binding DataContext.RemoveNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Delete note" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,6,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding NewNoteText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Add a note" />
                            <Button Grid.Column="1"
                                    Content="Add note"
                                    Margin="6,0,0,0"
                                    Command="{Binding DataContext.AddNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                        <Button Content="Save"
                                HorizontalAlignment="Left"
                                MinWidth="72"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding DataContext.SaveTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52"
                            CornerRadius="12"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource ChromeBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="58" Margin="18,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="28"
                            Height="28"
                            CornerRadius="7"
                            Background="{DynamicResource AccentBrush}"
                            Margin="0,0,10,0">
                        <TextBlock Text="✓"
                                   Foreground="#FFFFFF"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Task Planner"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Quick planning overlay"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="11" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="Start with Windows"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <primitives:ToggleButton Style="{StaticResource SwitchToggleStyle}"
                                             IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,18,0"
                                             ToolTip="Start Task Planner automatically when you sign in to Windows" />
                    <TextBlock Text="Theme"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <ComboBox Width="112"
                              Style="{StaticResource HeaderComboBoxStyle}"
                              ItemsSource="{Binding ThemeModes}"
                              SelectedItem="{Binding SelectedThemeMode, Mode=TwoWay}" />
                </StackPanel>
                <Button Grid.Column="2"
                        Content="×"
                        Style="{StaticResource ChromeButtonStyle}"
                        Command="{Binding ExitCommand}"
                        ToolTip="Exit Task Planner" />
            </Grid>

            <Border Grid.Row="1"
                    HorizontalAlignment="Left"
                    Margin="18,4,18,12"
                    Padding="3"
                    Background="{DynamicResource ButtonBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="✓  Tasks"
                                 Style="{StaticResource SegmentedRadioButtonStyle}"
                                 IsChecked="{Binding IsTasksView, Mode=TwoWay}"
                                 ToolTip="Show your tasks" />
                    <RadioButton Content="✎  Notes"
                                 Style="{StaticResource SegmentedRadioButtonStyle}"
                                 IsChecked="{Binding IsNotesView, Mode=TwoWay}"
                                 ToolTip="Show your notes" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Margin="18,0,18,16"
                    Visibility="{Binding IsTasksView, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Padding="16"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="Capture a task"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,10" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="QuickAddBox"
                                 Grid.Column="0"
                                 Margin="0,0,10,0"
                                 Text="{Binding NewTaskText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Examples: Send report tomorrow !high" />
                        <Button Grid.Column="1"
                                Content="Add task"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding AddTaskCommand}" />
                    </Grid>
                    <TextBlock Grid.Row="2"
                               Text="Manage topics"
                               Style="{StaticResource FormLabelStyle}"
                               Margin="0,8,0,4" />
                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.9*" />
                                <ColumnDefinition Width="1.1*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding Topics}"
                                      SelectedItem="{Binding TopicToManage, Mode=TwoWay}"
                                      Margin="0,0,8,10"
                                      ToolTip="Select a topic to rename or delete" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding NewTopicName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,10"
                                     ToolTip="New or replacement topic name" />
                        </Grid>
                        <WrapPanel Grid.Row="1"
                                   Orientation="Horizontal">
                            <Button Content="New topic"
                                    MinWidth="108"
                                    ToolTip="Create a topic"
                                    Command="{Binding CreateTopicCommand}" />
                            <Button Content="Rename topic"
                                    MinWidth="118"
                                    ToolTip="Rename the selected topic"
                                    Command="{Binding RenameTopicCommand}" />
                            <Button Content="Delete topic"
                                    MinWidth="112"
                                    Style="{StaticResource DestructiveButtonStyle}"
                                    ToolTip="Delete the selected topic and move its tasks to No topic"
                                    Command="{Binding DeleteTopicCommand}" />
                        </WrapPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    Margin="18,0,18,12"
                    Padding="14,10"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    DataContext="{Binding Pomodoro}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding PhaseText}"
                                       Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{Binding SessionText}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="11" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding RemainingText}"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   VerticalAlignment="Center"
                                   Margin="12,0,14,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBreak}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Content="{Binding StartPauseGlyph}"
                                    Width="34"
                                    Height="30"
                                    Padding="0"
                                    Style="{StaticResource AccentButtonStyle}"
                                    ToolTip="{Binding StartPauseToolTip}"
                                    Command="{Binding StartPauseCommand}" />
                            <Button Content="↺"
                                    Width="30"
                                    Height="30"
                                    Padding="0"
                                    Margin="4,0,0,0"
                                    ToolTip="Restart this phase"
                                    Command="{Binding ResetCommand}" />
                            <Button Content="⏭"
                                    Width="30"
                                    Height="30"
                                    Padding="0"
                                    Margin="4,0,0,0"
                                    ToolTip="Skip to the next phase"
                                    Command="{Binding SkipCommand}" />
                            <Button Content="⚙"
                                    Width="30"
                                    Height="30"
                                    Padding="0"
                                    Margin="4,0,0,0"
                                    ToolTip="Pomodoro durations"
                                    Command="{Binding ToggleSettingsCommand}" />
                        </StackPanel>
                    </Grid>
                    <ProgressBar Height="3"
                                 Margin="0,8,0,0"
                                 Minimum="0"
                                 Maximum="1"
                                 Value="{Binding Progress, Mode=OneWay}"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Background="{DynamicResource SubtleSurfaceBrush}" />
                    <StackPanel Visibility="{Binding IsSettingsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Margin="0,10,0,0">
                        <UniformGrid Columns="4">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Focus (min)"
                                           Style="{StaticResource FormLabelStyle}" />
                                <TextBox Text="{Binding FocusMinutesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Short break"
                                           Style="{StaticResource FormLabelStyle}" />
                                <TextBox Text="{Binding ShortBreakMinutesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Long break"
                                           Style="{StaticResource FormLabelStyle}" />
                                <TextBox Text="{Binding LongBreakMinutesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Long break every"
                                           Style="{StaticResource FormLabelStyle}" />
                                <TextBox Text="{Binding SessionsBeforeLongBreakText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Number of focus sessions before a long break" />
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="{Binding SettingsHint}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,6" />
                        <Button Content="Save"
                                HorizontalAlignment="Left"
                                MinWidth="72"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding SaveSettingsCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="4"
                  Margin="16,0,16,0"
                  Visibility="{Binding IsTasksView, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Padding="14"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top"
                              Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Tasks"
                                       Style="{StaticResource SectionTitleStyle}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Show completed"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <primitives:ToggleButton Style="{StaticResource SwitchToggleStyle}"
                                                         IsChecked="{Binding ShowCompleted, Mode=TwoWay}"
                                                         VerticalAlignment="Center"
                                                         ToolTip="Show or hide completed tasks" />
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding TopicGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,14">
                                                <Border Padding="8,6"
                                                        Background="{DynamicResource SubtleSurfaceBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="0,0,0,1"
                                                        AllowDrop="True"
                                                        PreviewMouseLeftButtonDown="TopicHeader_PreviewMouseLeftButtonDown"
                                                        PreviewMouseMove="TopicHeader_PreviewMouseMove"
                                                        Drop="TopicHeader_Drop">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0"
                                                                    Orientation="Horizontal">
                                                            <Border Width="3"
                                                                    Height="16"
                                                                    Margin="0,0,8,0"
                                                                    CornerRadius="2"
                                                                    Background="{DynamicResource AccentBrush}" />
                                                            <TextBlock Text="{Binding TopicName}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Content="{Binding ToggleGlyph}"
                                                                Width="28"
                                                                Height="26"
                                                                Padding="0"
                                                                Margin="8,0,0,0"
                                                                ToolTip="Expand or collapse topic"
                                                                Command="{Binding DataContext.ToggleTopicCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>
                                                </Border>
                                                <ListBox ItemsSource="{Binding Tasks}"
                                                         Style="{StaticResource GroupedTaskListStyle}"
                                                         ItemTemplate="{StaticResource TaskItemTemplate}"
                                                         Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>


            <Border Grid.Row="4"
                    Margin="16,0,16,0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="{Binding IsNotesView, Converter={StaticResource BooleanToVisibilityConverter}}"
                    DataContext="{Binding Notes}">
                <Border.InputBindings>
                    <KeyBinding Key="T"
                                Modifiers="Control"
                                Command="{Binding NewPageCommand}" />
                    <KeyBinding Key="W"
                                Modifiers="Control"
                                Command="{Binding CloseCommand}"
                                CommandParameter="{Binding SelectedPage}" />
                </Border.InputBindings>
                <DockPanel>
                    <Grid DockPanel.Dock="Top"
                          Margin="8,8,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer Grid.Column="0"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <ListBox ItemsSource="{Binding Pages}"
                                     SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                                     Style="{StaticResource NoteTabStripStyle}"
                                     ItemContainerStyle="{StaticResource NoteTabItemStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Background="Transparent"
                                              AllowDrop="True"
                                              ToolTip="Double-click to rename, drag to reorder"
                                              Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                              PreviewMouseLeftButtonDown="NoteTab_PreviewMouseLeftButtonDown"
                                              PreviewMouseMove="NoteTab_PreviewMouseMove"
                                              Drop="NoteTab_Drop">
                                            <Grid.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Rename"
                                                              Command="{Binding Tag.StartRenameCommand}"
                                                              CommandParameter="{Binding DataContext}" />
                                                    <MenuItem Header="Use first line as title"
                                                              IsEnabled="{Binding DataContext.HasCustomTitle}"
                                                              Command="{Binding Tag.UseFirstLineAsTitleCommand}"
                                                              CommandParameter="{Binding DataContext}" />
                                                    <Separator />
                                                    <MenuItem Header="Delete note"
                                                              Command="{Binding Tag.CloseCommand}"
                                                              CommandParameter="{Binding DataContext}" />
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding DisplayTitle}"
                                                       MaxWidth="150"
                                                       FontSize="13"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                       Visibility="{Binding IsRenaming, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding RenameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="150"
                                                     Margin="0"
                                                     Padding="4,1"
                                                     FontSize="13"
                                                     Visibility="{Binding IsRenaming, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                     ToolTip="Leave empty to use the first line of the note"
                                                     IsVisibleChanged="NoteRenameBox_IsVisibleChanged"
                                                     KeyDown="NoteRenameBox_KeyDown"
                                                     LostKeyboardFocus="NoteRenameBox_LostKeyboardFocus" />
                                            <Button Grid.Column="1"
                                                    Content="✕"
                                                    Style="{StaticResource TabIconButtonStyle}"
                                                    ToolTip="Close note (Ctrl+W)"
                                                    Command="{Binding DataContext.CloseCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                        <Button Grid.Column="1"
                                Content="+"
                                Width="30"
                                Height="30"
                                FontSize="17"
                                Margin="6,0,0,2"
                                VerticalAlignment="Center"
                                Style="{StaticResource TabIconButtonStyle}"
                                ToolTip="New note (Ctrl+T)"
                                Command="{Binding NewPageCommand}" />
                    </Grid>

                    <Border DockPanel.Dock="Top"
                            Margin="8,6,8,0"
                            Padding="12,8"
                            Background="{DynamicResource SubtleSurfaceBrush}"
                            BorderBrush="{DynamicResource DangerBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding IsDeletePending, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DeletePromptText}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Margin="10,0,0,0">
                                <Button Content="Delete"
                                        MinHeight="28"
                                        Padding="12,4"
                                        Style="{StaticResource DestructiveButtonStyle}"
                                        Command="{Binding ConfirmDeleteCommand}" />
                                <Button Content="Cancel"
                                        MinHeight="28"
                                        Padding="12,4"
                                        Margin="0"
                                        Command="{Binding CancelDeleteCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid DockPanel.Dock="Bottom"
                          Margin="16,6,16,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding SelectedPage.StatsText}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="11" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SaveStatusText}"
                                   FontSize="11">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSaveError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Grid Margin="0,6,0,0">
                        <Border BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,1"
                                Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBox x:Name="NoteEditor"
                                     Style="{StaticResource NoteEditorStyle}"
                                     Text="{Binding SelectedPage.Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Border>
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="✎"
                                       FontSize="34"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock Text="No notes yet"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,2" />
                            <TextBlock Text="Notes are saved automatically while you type."
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="0,0,0,14" />
                            <Button Content="New note"
                                    HorizontalAlignment="Center"
                                    Margin="0"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Command="{Binding NewPageCommand}" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <TextBlock Grid.Row="5"
                       Text="Ctrl+Shift+Space toggles the panel. Escape hides it."
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="12"
                       Margin="18,12,18,16"
                       Visibility="{Binding IsTasksView, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock Grid.Row="5"
                       Text="Ctrl+T new note · Ctrl+W close · double-click a tab to rename · drag to reorder"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="12"
                       TextTrimming="CharacterEllipsis"
                       Margin="18,12,18,16"
                       Visibility="{Binding IsNotesView, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>
    </Border>
</Window>
