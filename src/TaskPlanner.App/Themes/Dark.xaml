<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="ChromeColor">#202020</Color>
    <Color x:Key="SurfaceColor">#2B2B2B</Color>
    <Color x:Key="SubtleSurfaceColor">#252525</Color>
    <Color x:Key="BorderColor">#3D3D3D</Color>
    <Color x:Key="TextColor">#F3F3F3</Color>
    <Color x:Key="MutedTextColor">#B7B7B7</Color>
    <Color x:Key="ButtonColor">#333333</Color>
    <Color x:Key="ButtonHoverColor">#3D3D3D</Color>
    <Color x:Key="ButtonPressedColor">#494949</Color>
    <Color x:Key="SelectionHoverColor">#24324F</Color>
    <Color x:Key="SelectionColor">#1E3A5F</Color>
    <Color x:Key="WindowBorderColor">#4A4A4A</Color>
    <Color x:Key="AccentColor">#4F8CFF</Color>
    <Color x:Key="AccentHoverColor">#6EA1FF</Color>
    <Color x:Key="AccentPressedColor">#2F6FEA</Color>

    <SolidColorBrush x:Key="ChromeBrush" Color="{DynamicResource ChromeColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}" />
    <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="{DynamicResource SubtleSurfaceColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{DynamicResource MutedTextColor}" />
    <SolidColorBrush x:Key="ButtonBrush" Color="{DynamicResource ButtonColor}" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="{DynamicResource ButtonHoverColor}" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="{DynamicResource ButtonPressedColor}" />
    <SolidColorBrush x:Key="SelectionHoverBrush" Color="{DynamicResource SelectionHoverColor}" />
    <SolidColorBrush x:Key="SelectionBrush" Color="{DynamicResource SelectionColor}" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="{DynamicResource WindowBorderColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{DynamicResource AccentPressedColor}" />

    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{DynamicResource SurfaceColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="{DynamicResource SurfaceColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="{DynamicResource SurfaceColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{DynamicResource SelectionColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="{DynamicResource MutedTextColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{DynamicResource SelectionHoverColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{DynamicResource TextColor}" />
</ResourceDictionary>
